# Copy to .env.local. Only public (anon) values belong here â€” never a service-role key.
# Hosted publishable keys may start with sb_publishable_ (use that value for NEXT_PUBLIC_SUPABASE_ANON_KEY).

# Local Supabase (supabase start) â€” anon key is printed by `supabase status`.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-local-anon-key

# Hosted project (ref gbcegscbkzfxldvdiqdf):
# NEXT_PUBLIC_SUPABASE_URL=https://gbcegscbkzfxldvdiqdf.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-hosted-anon-key

# Optional integer build number sent as x-client-build for app_config compatibility checks.
NEXT_PUBLIC_APP_BUILD=1

# Server only. Never prefix this with NEXT_PUBLIC_. Required for admin account creation.
# Configure SUPABASE_SECRET_KEY (preferred), or SUPABASE_SERVICE_ROLE_KEY.
SUPABASE_SECRET_KEY=

# Private lesson file storage. R2 credentials must never be NEXT_PUBLIC_.
# Apply the R2 authorization migration and verify the copy before switching to r2.
LESSON_ASSET_STORAGE=supabase
R2_ACCOUNT_ID=
R2_BUCKET=scholau-assets
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
